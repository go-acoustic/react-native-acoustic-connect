{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@shared/*": [
        "../shared/*"
      ],
      // See the note in Examples/bare-workflow/tsconfig.json: resolve the SDK to
      // its TypeScript source rather than to the published tarball's lib/.
      "react-native-acoustic-connect-beta": [
        "../../src/index"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../shared/**/*.ts",
    "../shared/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
