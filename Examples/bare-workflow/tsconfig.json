{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "types": [],
    "paths": {
      "@shared/*": ["../shared/*", "./shared/*"],
      // Typecheck against the SDK's TypeScript source, the same copy Metro
      // bundles via the package's "react-native"/"source" fields. Without this
      // TypeScript follows "types" to lib/typescript instead — which in the
      // monorepo is whatever published tarball npm left in node_modules, so the
      // app runs in-tree code while typechecking a stale API. When this path
      // does not exist (the published standalone sample) TypeScript falls back
      // to normal node resolution and picks up the real package.
      "react-native-acoustic-connect-beta": ["../../src/index"]
    }
  },
  "include": ["App.tsx", "src/**/*", "../shared/**/*", "./shared/**/*"]
}
